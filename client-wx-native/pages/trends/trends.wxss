/* ============================================================
   历史趋势页 · 墨绿磨砂玻璃
   ============================================================ */

/* ============ 时间范围 ============ */
.range-bar {
  display: flex;
  margin: 8rpx 28rpx 0;
  padding: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(160deg, var(--glass-2), var(--glass));
  border: 1rpx solid var(--glass-line);
}
.range-item {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  border-radius: 999rpx;
  transition: all 0.24s ease;
}
.range-hover { opacity: 0.7; }
.range-active {
  color: #04241d;
  font-weight: 600;
  background: linear-gradient(135deg, #45f0cb, #16b98b);
  box-shadow: 0 12rpx 26rpx rgba(22, 185, 139, 0.28);
}

/* ============ 横向滑动统计卡 ============ */
.stat-scroll {
  width: 100%;
  white-space: nowrap;
}
.stat-scroll-inner {
  display: flex;
  padding: 4rpx 28rpx 8rpx;
}
.stat-card {
  flex-shrink: 0;
  width: 400rpx;
  margin-right: 20rpx;
  padding: 30rpx 28rpx 26rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(160deg, var(--glass-2), var(--glass));
  border: 1rpx solid var(--glass-line);
  box-shadow:
    0 18rpx 38rpx rgba(0, 0, 0, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}
.stat-card:last-child {
  margin-right: 28rpx;
}
.stat-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.stat-name {
  font-size: 25rpx;
  color: var(--text-2);
}
.stat-unit {
  font-size: 20rpx;
  color: var(--text-3);
}
.stat-main {
  margin-top: 14rpx;
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.05;
  color: var(--text);
  letter-spacing: -2rpx;
}
.stat-meta {
  display: flex;
  margin-top: 24rpx;
}
.stat-meta-item {
  flex: 1;
}
.stat-meta-item + .stat-meta-item {
  border-left: 1rpx solid rgba(255, 255, 255, 0.07);
  padding-left: 22rpx;
}
.stat-meta-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-3);
}
.stat-meta-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.stat-extreme {
  margin-top: 18rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

/* ============ 曲线区 ============ */
.chart-card {
  padding: 30rpx;
}
.chart-legend {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  margin-right: 30rpx;
  font-size: 22rpx;
  color: var(--text-2);
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}
.dot-danger { background: #fb7185; }
.dot-info { background: #7dd3fc; }
.dot-mint { background: var(--accent); }

.chart-body {
  position: relative;
  height: 360rpx;
  padding: 26rpx 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-radius: var(--r-md);
  background: rgba(0, 0, 0, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  overflow: hidden;
}




.chart-xaxis {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

/* ============ 折线图画布（Canvas 2D，团队实现） ============ */
.chart-body {
  position: relative;
  height: 420rpx;
  border-radius: var(--r-md);
  background: rgba(0, 0, 0, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  overflow: hidden;
}
.trends-canvas {
  width: 100%;
  height: 100%;
  display: block;
}
.chart-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  text-align: center;
  font-size: 24rpx;
  color: var(--text-2);
}
.chart-retry {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--accent);
  text-decoration: underline;
}
