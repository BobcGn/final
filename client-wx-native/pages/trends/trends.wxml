<!--
  历史趋势。
  窗口由共享层的 from/to 边界决定，服务端返回最近一页并已反转为升序；
  本页不做二次过滤、不做浮点格式化（统计值已是整数字符串）。
-->
<view class="page">
  <!-- 页头 -->
  <view class="page-head">
    <view class="page-head-title">历史趋势</view>
    <view class="page-head-sub">数据统计与曲线</view>
  </view>

  <!-- ============ 时间范围 ============ -->
  <view class="range-bar">
    <view
      wx:for="{{windowOptions}}"
      wx:key="key"
      class="range-item {{trendWindow === item.key ? 'range-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onRange"
      hover-class="range-hover"
      hover-stay-time="60"
    >{{item.label}}</view>
  </view>

  <view class="hint" wx:if="{{loading}}">数据加载中...</view>
  <view class="hint" wx:if="{{error}}">{{error}}</view>
  <view class="hint" wx:if="{{trends && !trends.hasData}}">所选区间内没有遥测样本</view>

  <block wx:if="{{trends && trends.hasData}}">
    <!-- ============ 统计摘要（横向滑动） ============ -->
    <view class="section-head">
      <view class="section-title">统计摘要</view>
      <view class="section-tip">共 {{trends.sampleCount}} 条样本</view>
    </view>

    <scroll-view class="stat-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="stat-scroll-inner">
        <view class="stat-card">
          <view class="stat-top">
            <text class="stat-name">温度</text>
            <text class="stat-unit">°C</text>
          </view>
          <view class="stat-main">{{trends.temperature.average}}</view>
          <view class="stat-meta">
            <view class="stat-meta-item">
              <text class="stat-meta-label">最低</text>
              <text class="stat-meta-value">{{trends.temperature.minimum}}</text>
            </view>
            <view class="stat-meta-item">
              <text class="stat-meta-label">最高</text>
              <text class="stat-meta-value">{{trends.temperature.maximum}}</text>
            </view>
          </view>
          <view class="stat-extreme">峰值 {{trends.temperature.peakAt}}</view>
        </view>

        <view class="stat-card">
          <view class="stat-top">
            <text class="stat-name">湿度</text>
            <text class="stat-unit">%RH</text>
          </view>
          <view class="stat-main">{{trends.humidity.average}}</view>
          <view class="stat-meta">
            <view class="stat-meta-item">
              <text class="stat-meta-label">最低</text>
              <text class="stat-meta-value">{{trends.humidity.minimum}}</text>
            </view>
            <view class="stat-meta-item">
              <text class="stat-meta-label">最高</text>
              <text class="stat-meta-value">{{trends.humidity.maximum}}</text>
            </view>
          </view>
          <view class="stat-extreme">峰值 {{trends.humidity.peakAt}}</view>
        </view>

        <view class="stat-card">
          <view class="stat-top">
            <text class="stat-name">气体</text>
            <text class="stat-unit">ppm</text>
          </view>
          <view class="stat-main">{{trends.gas.average}}</view>
          <view class="stat-meta">
            <block wx:if="{{trends.gasSampleCount > 0}}">
              <view class="stat-meta-item">
                <text class="stat-meta-label">最低</text>
                <text class="stat-meta-value">{{trends.gas.minimum}}</text>
              </view>
              <view class="stat-meta-item">
                <text class="stat-meta-label">最高</text>
                <text class="stat-meta-value">{{trends.gas.maximum}}</text>
              </view>
            </block>
            <text class="stat-meta-label" wx:else>无已校准气体读数</text>
          </view>
          <view class="stat-extreme" wx:if="{{trends.gasSampleCount > 0}}">峰值 {{trends.gas.peakAt}}</view>
        </view>
      </view>
    </scroll-view>

    <view class="hint" wx:if="{{trends.gasSampleCount < trends.sampleCount}}">
      {{trends.sampleCount - trends.gasSampleCount}} 条样本没有已校准气体读数，未计入气体统计
    </view>

    <!-- ============ 曲线区 ============ -->
    <view class="section-head">
      <view class="section-title">曲线视图</view>
      <view class="section-tip">{{trends.curveStatusText}}</view>
    </view>

    <view class="card chart-card">
      <view class="chart-legend">
        <view class="legend-item" wx:for="{{trends.curveLegend}}" wx:key="label">
          <view class="legend-dot dot-{{item.tone}}"></view><text>{{item.label}}</text>
        </view>
      </view>
      <view class="chart-body">
        <view class="grid-line" wx:for="{{[0,1,2,3]}}" wx:key="*this"></view>
        <view class="chart-mask">
          <view class="chart-mask-title">{{trends.curveMaskTitle}}</view>
          <view class="chart-mask-sub">{{trends.curveMaskSub}}</view>
        </view>
      </view>
      <view class="chart-xaxis">
        <text>{{trends.curveAxisStart}}</text>
        <text>{{trends.curveAxisEnd}}</text>
      </view>
    </view>

    <view class="hint">{{trends.footerHint}}</view>
  </block>
</view>
