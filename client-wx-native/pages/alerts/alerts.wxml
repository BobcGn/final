<view class="page">
  <!-- 页头 -->
  <view class="page-head">
    <view class="page-head-title">告警记录</view>
    <view class="page-head-sub">早期火情预警事件</view>
  </view>

  <!-- ============ 筛选 ============ -->
  <view class="filter-bar">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="filter-item {{activeFilter === item.key ? 'filter-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onFilterTap"
      hover-class="filter-hover"
      hover-stay-time="60"
    >{{item.label}}</view>
  </view>

  <view class="hint" wx:if="{{loading && !alertsView}}">数据加载中...</view>
  <view class="hint value-red" wx:if="{{error}}">{{error}}</view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && !error && alertsView && alertsView.visibleCount === 0}}">
    <view class="empty-icon">🛡</view>
    <view class="empty-text">该分类下暂无告警记录</view>
  </view>

  <!-- ============ 告警卡片 ============ -->
  <block wx:if="{{alertsView && alertsView.visibleCount > 0}}">
    <view class="alert-card" wx:for="{{alertsView.items}}" wx:key="id">
      <view class="alert-head">
        <view class="alert-left">
          <view class="alert-dot dot-{{item.state}}"></view>
          <text class="tag tag-{{item.tone === 'danger' ? 'red' : (item.tone === 'warning' ? 'amber' : (item.tone === 'info' ? 'blue' : 'green'))}}">{{item.stateText}}</text>
        </view>
        <text class="alert-time">{{item.startedAt}}</text>
      </view>

      <view class="evidence">
        <view class="evidence-head">触发证据</view>
        <view class="evidence-grid">
          <view class="evidence-cell">
            <text class="cell-label">气体 ADC 上升</text>
            <text class="cell-value">{{item.gasAdcRiseText}}</text>
          </view>
          <view class="evidence-cell">
            <text class="cell-label">触发阈值</text>
            <text class="cell-value">{{item.gasAdcRiseThresholdText}}</text>
          </view>
          <view class="evidence-cell">
            <text class="cell-label">温升速率</text>
            <text class="cell-value">{{item.temperatureRateText}}</text>
          </view>
          <view class="evidence-cell">
            <text class="cell-label">样本数</text>
            <text class="cell-value">{{item.sampleCountText}}</text>
          </view>
        </view>
      </view>

      <view class="alert-foot" wx:if="{{!item.active}}">
        <text>已恢复 {{item.endedAt}}</text>
      </view>
    </view>
  </block>
</view>
