/* ============================================================
   告警记录页 · 墨绿磨砂玻璃
   ============================================================ */

/* ============ 筛选胶囊 ============ */
.filter-bar {
  display: flex;
  margin: 8rpx 28rpx 10rpx;
}
.filter-item {
  flex: 1;
  margin-right: 12rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-2);
  border-radius: 999rpx;
  background: linear-gradient(160deg, var(--glass-2), var(--glass));
  border: 1rpx solid var(--glass-line);
  transition: all 0.2s ease;
}
.filter-item:last-child {
  margin-right: 0;
}
.filter-hover { opacity: 0.7; }
.filter-active {
  color: #04241d;
  font-weight: 600;
  background: linear-gradient(135deg, #45f0cb, #16b98b);
  border-color: transparent;
  box-shadow: 0 12rpx 26rpx rgba(22, 185, 139, 0.28);
}

/* ============ 告警卡片 ============ */
.alert-card {
  margin: 20rpx 28rpx;
  padding: 30rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(160deg, var(--glass-2), var(--glass));
  border: 1rpx solid var(--glass-line);
  box-shadow:
    0 18rpx 38rpx rgba(0, 0, 0, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}
.alert-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.alert-left {
  display: flex;
  align-items: center;
}
.alert-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: var(--text-3);
}
.dot-fire_warning {
  background: var(--danger);
  box-shadow: 0 0 16rpx rgba(251, 113, 133, 0.5);
}
.dot-suspect {
  background: var(--warn);
  box-shadow: 0 0 14rpx rgba(245, 201, 107, 0.45);
}
.dot-recovered {
  background: var(--ok);
  box-shadow: 0 0 14rpx var(--glow);
}
.alert-time {
  font-size: 21rpx;
  color: var(--text-3);
}

/* ============ 证据面板 ============ */
.evidence {
  margin-top: 24rpx;
  padding: 24rpx 26rpx 20rpx;
  border-radius: var(--r-md);
  background: rgba(0, 0, 0, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}
.evidence-head {
  font-size: 22rpx;
  color: var(--text-3);
  margin-bottom: 18rpx;
}
.evidence-grid {
  display: flex;
  flex-wrap: wrap;
}
.evidence-cell {
  width: 50%;
  padding: 10rpx 0;
}
.cell-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-3);
  margin-bottom: 4rpx;
}
.cell-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.cell-unit {
  margin-left: 4rpx;
  font-size: 19rpx;
  font-weight: 400;
  color: var(--text-3);
}

/* ============ 底部时间 ============ */
.alert-foot {
  display: flex;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  font-size: 21rpx;
  color: var(--text-3);
}
.alert-foot text {
  margin-right: 28rpx;
}
