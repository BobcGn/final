<!--
  预警阈值。
  三个阈值字段都要下发（契约必填），湿度在界面上不可编辑但对齐 KMP 一起发送；
  保存后轮询命令终态，只有设备 applied 才算成功。
-->
<view class="page">
  <!-- 页头 -->
  <view class="page-head">
    <view class="page-head-title">预警阈值</view>
    <view class="page-head-sub">设置设备本地报警的安全边界</view>
  </view>

  <view class="hint" wx:if="{{loading}}">数据加载中...</view>
  <view class="hint" wx:if="{{error}}">{{error}}</view>

  <block wx:if="{{settings}}">
    <!-- ============ 报警规则 ============ -->
    <view class="section-head">
      <view class="section-title">报警规则</view>
      <view class="section-tip">修改后需下发设备</view>
    </view>

    <view class="card">
      <view class="card-title">温度上限</view>
      <view class="set-value">
        <text class="set-num">{{temperatureHighC}}</text>
        <text class="set-unit">°C</text>
      </view>
      <slider
        min="0"
        max="80"
        step="0.5"
        value="{{temperatureHighC}}"
        activeColor="#3fe8c3"
        backgroundColor="rgba(255,255,255,0.12)"
        block-size="26"
        block-color="#ffffff"
        bindchange="onTemp"
        bindchanging="onTemp"
      />
      <view class="range-hint">
        <text>0 °C</text>
        <text>80 °C</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">气体浓度上限</view>
      <view class="set-value">
        <text class="set-num">{{gasHighPpm}}</text>
        <text class="set-unit">ppm</text>
      </view>
      <slider
        min="1"
        max="999"
        step="1"
        value="{{gasHighPpm}}"
        activeColor="#3fe8c3"
        backgroundColor="rgba(255,255,255,0.12)"
        block-size="26"
        block-color="#ffffff"
        bindchange="onGas"
        bindchanging="onGas"
      />
      <view class="range-hint">
        <text>1 ppm</text>
        <text>999 ppm</text>
      </view>
    </view>

    <!-- ============ 设备确认 ============ -->
    <view class="section-head">
      <view class="section-title">设备确认</view>
      <view class="section-tip">确保规则已生效</view>
    </view>

    <view class="list-card">
      <view class="list-row">
        <text class="list-label">规则同步状态</text>
        <text class="list-value tone-{{settings.confirmationTone}}">{{settings.confirmationText}}</text>
      </view>
      <view class="list-row">
        <text class="list-label">期望版本</text>
        <text class="list-value">{{settings.desiredVersion}}</text>
      </view>
      <view class="list-row">
        <text class="list-label">设备确认版本</text>
        <text class="list-value">{{settings.confirmedVersion}}</text>
      </view>
      <view class="list-row">
        <text class="list-label">更新时间</text>
        <text class="list-value">{{settings.updatedAt}}</text>
      </view>
    </view>

    <view class="save-wrap">
      <button class="btn btn-primary save-btn" bindtap="onSave" disabled="{{saving}}" loading="{{saving}}">
        保存并下发到设备
      </button>
    </view>
    <view class="command-hint command-hint-{{commandTone}}" wx:if="{{commandHint}}">{{commandHint}}</view>
    <view class="hint">{{settings.saveHint}}</view>
  </block>
</view>
