/* ============================================================
   机房总览页 · 墨绿磨砂玻璃
   ============================================================ */

/* ============ 系统风险状态 ============ */
.risk-label {
  font-size: 23rpx;
  color: var(--text-3);
}
.risk-main {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.risk-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  background: var(--ok);
  box-shadow: 0 0 18rpx var(--glow);
  animation: breathe 2.8s ease-in-out infinite;
}
.risk-text {
  flex: 1;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ok);
  letter-spacing: 1rpx;
}
.risk-pill {
  flex-shrink: 0;
}
.risk-sub {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--text-2);
}

/* 状态配色 */
.level-suspect.risk-dot { background: var(--warn); box-shadow: 0 0 18rpx rgba(245, 201, 107, 0.4); animation-duration: 1.6s; }
.level-suspect.risk-text { color: var(--warn); }
.level-fire.risk-dot { background: var(--danger); box-shadow: 0 0 20rpx rgba(251, 113, 133, 0.55); animation-duration: 1.2s; }
.level-fire.risk-text { color: var(--danger); }
.level-recovered.risk-dot { background: var(--info); box-shadow: 0 0 18rpx rgba(125, 211, 252, 0.45); }
.level-recovered.risk-text { color: var(--info); }

@keyframes breathe {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* ============ 实时数据三卡 ============ */
.meters {
  display: flex;
  margin: 0 28rpx;
}
.meter {
  flex: 1;
  padding: 26rpx 22rpx 24rpx;
  border-radius: var(--r-md);
  background: linear-gradient(160deg, var(--glass-2), var(--glass));
  border: 1rpx solid var(--glass-line);
  box-shadow:
    0 16rpx 34rpx rgba(0, 0, 0, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}
.meter + .meter {
  margin-left: 16rpx;
}
.meter-top {
  display: flex;
  align-items: center;
}
.meter-badge {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 12rpx;
  margin-right: 12rpx;
}
.badge-temp { background: rgba(251, 146, 116, 0.18); color: #ffa183; }
.badge-hum { background: rgba(125, 211, 252, 0.18); color: #8ed6ff; }
.badge-gas { background: rgba(63, 232, 195, 0.18); color: var(--accent); }
.meter-label {
  font-size: 23rpx;
  color: var(--text-2);
}
.meter-value {
  margin-top: 16rpx;
  font-size: 50rpx;
  font-weight: 600;
  line-height: 1.1;
  color: var(--text);
  letter-spacing: -1rpx;
}
.meter-unit {
  margin-left: 6rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-3);
}
.meter-track {
  margin-top: 18rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}
.meter-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.6s ease;
}
.fill-temp { background: linear-gradient(90deg, #ffb27d, #fb7185); }
.fill-hum { background: linear-gradient(90deg, #8ed6ff, #a5b4fc); }
.fill-gas { background: linear-gradient(90deg, #45f0cb, #f5c96b); }

/* ============ 设备状态 ============ */
.device-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.device-name-wrap {
  display: flex;
  align-items: center;
}
.device-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: var(--ok);
  box-shadow: 0 0 0 6rpx rgba(63, 232, 195, 0.12);
  animation: breathe 2.8s ease-in-out infinite;
}
.device-dot-off {
  background: var(--text-3);
  box-shadow: none;
  animation: none;
}
.device-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 2rpx;
}
.device-grid {
  display: flex;
  margin-top: 28rpx;
}
.device-cell {
  flex: 1;
}
.cell-label {
  display: block;
  font-size: 21rpx;
  color: var(--text-3);
  margin-bottom: 8rpx;
}
.cell-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}
