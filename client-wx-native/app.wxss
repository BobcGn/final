/* ============================================================
   全局设计系统 v4 · EMERALD FROST（墨绿磨砂玻璃）
   要点：深墨绿底、半透明磨砂卡、薄荷渐变强调、圆润留白
   ============================================================ */

page {
  --bg: #071310;
  --glass: rgba(255, 255, 255, 0.055);
  --glass-2: rgba(255, 255, 255, 0.085);
  --glass-line: rgba(255, 255, 255, 0.09);
  --accent: #3fe8c3;
  --accent-deep: #16b98b;
  --glow: rgba(63, 232, 195, 0.3);
  --text: #ecf5f2;
  --text-2: #8fa8a2;
  --text-3: #61786f;
  --ok: #3fe8c3;
  --warn: #f5c96b;
  --danger: #fb7185;
  --info: #7dd3fc;
  --r-lg: 30rpx;
  --r-md: 24rpx;

  background-color: var(--bg);
  background-image:
    radial-gradient(820rpx 560rpx at 50% -12%, rgba(24, 130, 100, 0.3), transparent 62%),
    radial-gradient(600rpx 420rpx at 100% 8%, rgba(22, 185, 139, 0.12), transparent 60%);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ============ 页面容器 ============ */
.page {
  padding: 0 0 200rpx;
}

/* ============ 页头 ============ */
.page-head {
  padding: 44rpx 32rpx 10rpx;
}
.page-head-title {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--text);
}
.page-head-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
}

/* ============ 区块标题（左标题 + 右提示，参考截图） ============ */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 44rpx 32rpx 20rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}
.section-tip {
  font-size: 21rpx;
  color: var(--text-3);
}

/* ============ 磨砂玻璃卡片 ============ */
.card {
  position: relative;
  margin: 20rpx 28rpx;
  padding: 30rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(160deg, var(--glass-2) 0%, var(--glass) 100%);
  border: 1rpx solid var(--glass-line);
  box-shadow:
    0 18rpx 40rpx rgba(0, 0, 0, 0.34),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.09);
  overflow: hidden;
}
/* 卡片内部的一层微光，模拟玻璃反光 */
.card::after {
  content: '';
  position: absolute;
  top: -40%;
  left: -10%;
  width: 60%;
  height: 90%;
  background: radial-gradient(closest-side, rgba(255, 255, 255, 0.06), transparent);
  pointer-events: none;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 26rpx;
  color: var(--text-2);
}

/* ============ 胶囊标签 ============ */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.5;
}
.tag-green {
  background: rgba(63, 232, 195, 0.16);
  color: var(--accent);
}
.tag-red { background: rgba(251, 113, 133, 0.16); color: var(--danger); }
.tag-amber { background: rgba(245, 201, 107, 0.16); color: var(--warn); }
.tag-blue { background: rgba(125, 211, 252, 0.16); color: var(--info); }
.tag-gray { background: rgba(143, 168, 162, 0.16); color: var(--text-2); }

/* ============ 按钮（薄荷渐变胶囊） ============ */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 94rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border: none;
}
.btn-primary {
  background: linear-gradient(135deg, #45f0cb 0%, #16b98b 100%);
  color: #04241d;
  box-shadow: 0 16rpx 34rpx rgba(22, 185, 139, 0.32);
}
.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 18rpx rgba(22, 185, 139, 0.3);
}
.btn-outline {
  background: rgba(63, 232, 195, 0.1);
  color: var(--accent);
  border: 1rpx solid rgba(63, 232, 195, 0.36);
}

/* ============ 信息行列表 ============ */
.list-card {
  margin: 20rpx 28rpx;
  padding: 6rpx 30rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(160deg, var(--glass-2), var(--glass));
  border: 1rpx solid var(--glass-line);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.3);
}
.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.list-row:last-child {
  border-bottom: none;
}
.list-label {
  font-size: 26rpx;
  color: var(--text-2);
}
.list-value {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
}

/* ============ 文字色与提示 ============ */
.value-red { color: var(--danger); }
.value-green { color: var(--ok); }
.value-amber { color: var(--warn); }
.hint {
  margin: 40rpx 32rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--text-3);
}

/* ============ 空状态 ============ */
.empty {
  margin: 140rpx 32rpx;
  text-align: center;
}
.empty-icon {
  font-size: 74rpx;
  opacity: 0.3;
}
.empty-text {
  margin-top: 20rpx;
  font-size: 25rpx;
  color: var(--text-3);
}

/* ============================================================
   tone 令牌 -> 宿主配色
   共享展示层只输出与平台无关的 tone（mint/warning/danger/info），
   由宿主决定具体颜色；Android 与微信端因此对同一状态给出同一语义、不同主题色。
   ============================================================ */
.tone-mint { color: #3fe8c3; }
.tone-warning { color: #f5c96b; }
.tone-danger { color: #fb7185; }
.tone-info { color: #7dd3fc; }

/* 状态点：与文字同语义 */
.risk-dot.tone-mint,
.alert-dot.tone-mint {
  background: #3fe8c3;
  box-shadow: 0 0 18rpx rgba(63, 232, 195, 0.4);
}
.risk-dot.tone-warning,
.alert-dot.tone-warning {
  background: #f5c96b;
  box-shadow: 0 0 18rpx rgba(245, 201, 107, 0.4);
}
.risk-dot.tone-danger,
.alert-dot.tone-danger {
  background: #fb7185;
  box-shadow: 0 0 18rpx rgba(251, 113, 133, 0.45);
}
.risk-dot.tone-info,
.alert-dot.tone-info {
  background: #7dd3fc;
  box-shadow: 0 0 18rpx rgba(125, 211, 252, 0.4);
}

/* 胶囊标签 */
.pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.5;
}
.pill-mint { background: rgba(63, 232, 195, 0.16); color: #3fe8c3; }
.pill-warning { background: rgba(245, 201, 107, 0.16); color: #f5c96b; }
.pill-danger { background: rgba(251, 113, 133, 0.16); color: #fb7185; }
.pill-info { background: rgba(125, 211, 252, 0.16); color: #7dd3fc; }
.pill-muted { background: rgba(143, 168, 162, 0.16); color: #8fa8a2; }

/* 控制命令结果提示：拒绝 / 超时 / 已确认必须在视觉上可区分 */
.command-hint {
  margin: 20rpx 0 0;
  padding: 18rpx 24rpx;
  border-radius: var(--r-md);
  font-size: 23rpx;
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-2);
}
.command-hint-mint { background: rgba(63, 232, 195, 0.14); color: #3fe8c3; }
.command-hint-warning { background: rgba(245, 201, 107, 0.14); color: #f5c96b; }
.command-hint-danger { background: rgba(251, 113, 133, 0.16); color: #fb7185; }
.command-hint-info { background: rgba(125, 211, 252, 0.14); color: #7dd3fc; }
